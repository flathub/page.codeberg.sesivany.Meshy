{
    "app-id": "page.codeberg.sesivany.Meshy",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "meshy",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--system-talk-name=org.bluez",
        "--share=network",
        "--device=all"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
"*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "zbar",
            "buildsystem": "meson",
            "config-opts": [
                "-Dqt=false",
                "-Dgtk=no",
                "-Djava=disabled",
                "-Dimagemagick=disabled",
                "-Ddbus=disabled",
                "-Dnpapi=disabled",
                "-Dxv=disabled",
                "-Dxshm=disabled",
                "-Dvideo=false",
                "-Dnls=disabled"
            ],
            "cleanup": [
                "/share/doc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://linuxtv.org/downloads/zbar/zbar-0.23.95.tar.gz",
                    "sha256": "7b0907a3114503e0a8fbd1c6bfdb61592e6ded79f68716d7ca673ddeb6a87e99"
                }
            ]
        },
        {
            "name": "python-pyzbar",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --find-links=. --prefix=/app pyzbar"
            ],
            "cleanup": [
                "/bin/read_zbar*",
                "/bin/__pycache__",
                "/lib/python*/site-packages/pyzbar/tests",
                "/lib/python*/site-packages/pyzbar*.dist-info"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/6d/24/81ebe6a1c00760471a3028a23cbe0b94e5fa2926e5ba47adc895920887bc/pyzbar-0.1.9-py2.py3-none-any.whl",
                    "sha256": "4559628b8192feb25766d954b36a3753baaf5c97c03135aec7e4a026036b475d"
                }
            ]
        },
        {
            "name": "python-crypto-deps",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-build-isolation --prefix=/app ."
            ],
            "cleanup": [
                "/lib/python*/site-packages/Crypto/SelfTest",
                "/lib/python*/site-packages/pycryptodome*.dist-info"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/51/f2/ccbeb91d186b2323fc99986499d2da3caab2151b1c2fb2ef74f7488d8934/pycryptodome-4.4.0.tar.gz",
                    "sha256": "eab7620c60c85f3fa251d026ec06e094f036d96187bebb9752e46fbcebabbb55"
                }
            ]
        },
        {
            "name": "python-segno",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --find-links=. --prefix=/app segno"
            ],
            "cleanup": [
                "/bin/segno",
                "/share/man",
                "/lib/python*/site-packages/segno*.dist-info"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/d6/02/12c73fd423eb9577b97fc1924966b929eff7074ae6b2e15dd3d30cb9e4ae/segno-1.6.6-py3-none-any.whl",
                    "sha256": "28c7d081ed0cf935e0411293a465efd4d500704072cdb039778a2ab8736190c7"
                }
            ]
        },
        {
            "name": "python-pyserial",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --find-links=. --prefix=/app pyserial"
            ],
            "cleanup": [
                "/bin/pyserial-*",
                "/lib/python*/site-packages/pyserial*.dist-info"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/07/bc/587a445451b253b285629263eb51c2d8e9bcea4fc97826266d186f96f558/pyserial-3.5-py2.py3-none-any.whl",
                    "sha256": "c4451db6ba391ca6ca299fb3ec7bae67a5c55dde170964c7a14ceefec02f2cf0"
                }
            ]
        },
        {
            "name": "protobuf-c",
            "buildsystem": "autotools",
            "config-opts": [
                "--disable-protoc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/protobuf-c/protobuf-c/releases/download/v1.5.2/protobuf-c-1.5.2.tar.gz",
                    "sha256": "e2c86271873a79c92b58fef7ebf8de1aa0df4738347a8bd5d4e65a80a16d0d24"
                }
            ]
        },
        {
            "name": "python-msgpack",
            "buildsystem": "simple",
            "build-commands": [
                "pip3 install --no-index --no-build-isolation --prefix=/app ."
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://files.pythonhosted.org/packages/cc/52/1ec7ead2c7528bf3d1db73e886fa4df10f9e6f0eb7854a448b7090cfcef7/msgpack-1.2.4.tar.gz",
                    "sha256": "475c44e12f2a5de766a8448783f149c9b33f3f49b88953c6cd739a77d93c732c"
                }
            ]
        },
        {
            "name": "libshumate",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgtk_doc=false",
                "-Ddemos=false",
                "-Dvapi=false",
                "-Dsysprof=disabled"
            ],
            "cleanup": [
                "/share/gir-1.0"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libshumate/1.7/libshumate-1.7.0.tar.xz",
                    "sha256": "3896cc4b6a7bf83141c27df23ce48cdd68467603bc6b764960307cdcbbef80e5"
                }
            ]
        },
        {
            "name": "meshy",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/sesivany/meshy.git",
                    "tag": "26.11",
                    "commit": "b0c3c03ac96e24beeb100e021d965e9df66724bc"
                }
            ]
        }
    ]
}
